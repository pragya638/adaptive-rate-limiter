# Leave empty to use same-origin /api requests through the Vite dev proxy.
# For a deployed frontend, set this to the public backend origin, e.g.
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Same-origin path used by the development proxy for the optional ML check.
# The browser never receives the internal ML service host or port.
VITE_ML_HEALTH_URL=/ml/health
